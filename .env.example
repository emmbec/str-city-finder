# Deployment configuration only. Investment rules belong in config/buybox.yaml.
BUYBOX_CONFIG_PATH=config/buybox.yaml
AZURE_KEY_VAULT_URL=https://your-key-vault.vault.azure.net/
AZURE_STORAGE_ACCOUNT_URL=https://your-storage-account.table.core.windows.net
AZURE_BLOB_SERVICE_URL=https://your-storage-account.blob.core.windows.net
AZURE_BLOB_CONTAINER=creative-listing-artifacts
CREATIVE_LISTING_SESSION_BLOB_CONTAINER=private-session-container-name
CREATIVE_LISTING_SESSION_BLOB_NAME=auth/storage-state.json
CREATIVE_LISTING_USERNAME_SECRET_NAME=creative-listing-username
CREATIVE_LISTING_PASSWORD_SECRET_NAME=creative-listing-password
CREATIVE_LISTING_BASE_URL=https://www.creativelisting.com/
CREATIVE_LISTING_LOGIN_PATH=/login
CREATIVE_LISTING_LISTINGS_PATH=/listings
CREATIVE_LISTING_HEADLESS=true
CREATIVE_LISTING_STATE_PATH=.local/creative-listing/storage-state.json
CREATIVE_LISTING_NAVIGATION_TIMEOUT_MS=30000
CREATIVE_LISTING_SELECTOR_TIMEOUT_MS=10000
CREATIVE_LISTING_RETRY_ATTEMPTS=3
CREATIVE_LISTING_RETRY_DELAY_MS=500
CREATIVE_LISTING_MAXIMUM_PAGES=500
CREATIVE_LISTING_DIAGNOSTICS_DIR=test-results/creative-listing
# Off by default. Post-auth traces omit DOM snapshots and sources and must still be stored privately.
CREATIVE_LISTING_CAPTURE_TRACE=false
# Optional local override when Playwright's bundled Chromium is installed elsewhere.
# CREATIVE_LISTING_BROWSER_EXECUTABLE_PATH=C:\path\to\chrome.exe
