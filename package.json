{
  "name": "str-city-finder",
  "version": "0.1.0",
  "private": true,
  "description": "YAML-driven Creative Listing opportunity screening for STR investments.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
